DATABASE_PATH=./data/orqiva.db
PORT=3001
NODE_ENV=development
SEED_DEMO=true
# Required for seed. Use a unique password, at least 10 characters.
SEED_PASSWORD=ChangeThisPassword2026!
# Enable only with HTTPS (or an HTTPS reverse proxy).
COOKIE_SECURE=false
# For cross-site HTTPS embeds: sets Secure + SameSite=None + Partitioned.
# Automatically enabled for development previews hosted under *.e2b.app.
COOKIE_PARTITIONED=false
# Preview-only password prefilling; keep disabled for your own installation.
VITE_DEMO_LOGIN=false
